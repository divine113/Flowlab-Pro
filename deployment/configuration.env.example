# Copy to configuration.env and keep the completed file private.
# For the existing shared database, set its real connection URL here.
# Leaving these blank creates separate EMPTY local SQLite databases; it does NOT copy your existing records.
FLOWLAB_DATABASE_URL=
EI_LAB_DATABASE_URL=
DATABASE_URL=
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_SECURE_COOKIES=0
# Public hosting (one origin serves BOTH modules). Uncomment/set for HTTPS:
# EATL_PUBLIC_URL=https://your-lab.example.com
# DJANGO_SECURE_COOKIES=1
# EATL_PORT=5050
# Trust only the local ngrok/nginx proxy's scheme header. Never use '*'.
# EATL_TRUSTED_PROXY=127.0.0.1
# Source runner only: use 0.0.0.0 for direct LAN access, behind your firewall.
# EATL_BIND_HOST=127.0.0.1
# Keep the existing data folder beside the executable, preserving its subfolders.
